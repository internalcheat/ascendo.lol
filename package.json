{
  "name": "ascendo-profile-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/profile-features.mjs && node tests/studio-regression.mjs && node tests/invitations.mjs && node tests/studio-controls.mjs && node tests/studio-suite.mjs",
    "build:upload": "esbuild upload-source.mjs --bundle --minify --format=esm --target=es2022 --outfile=vendor/upload.mjs",
    "build:backgrounds": "node build-backgrounds.mjs",
    "build:flux": "node build-flux.mjs",
    "build:entry-sounds": "node build-entry-sounds.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4"
  }
}
