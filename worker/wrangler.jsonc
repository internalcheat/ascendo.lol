{
  "name": "ascendo-profile-previews",
  "main": "index.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "env": {
    "staging": {
      "name": "ascendo-profile-previews-staging",
      "workers_dev": true,
      "vars": {"ORIGIN_URL": "https://raw.githubusercontent.com/internalcheat/ascendo.lol/profile-sharing"}
    }
  }
}
